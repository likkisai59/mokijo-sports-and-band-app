    EMAIL_VER --> LOGIN{Login Page}

    LOGIN -->|"Club Admin login"| LOGIN_ADMIN["/login"]
    LOGIN -->|"Member login"| LOGIN_MEMBER["/login-member"]
    LOGIN -->|"Venue Owner login"| LOGIN_VENUE["/login-venue"]
    LOGIN -->|"Trainer login"| LOGIN_TRAINER

    LOGIN_ADMIN --> JWT["🔑 JWT Token Issued\nStored in localStorage"]
    LOGIN_MEMBER --> JWT
    LOGIN_VENUE --> JWT
    LOGIN_TRAINER --> JWT_T["🔑 JWT role trainer"]

    JWT --> DASHBOARD{Routed to Dashboard}
    JWT_T --> TRAINER_DASH["🏃 Trainer Dashboard\n/trainer-dashboard"]
    DASHBOARD -->|"Admin"| ADMIN_DASH["🏠 Club Admin Dashboard\n/dashboard"]
